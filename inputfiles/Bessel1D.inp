# INPUTFILE for Bessel wave in 1D


#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%
SaveDirName    = data   # Output directory
RestartDirName = data   # Restart directory (for WriteMethod=default)

#  %%%%%%%%%%%%%%%%%%% Input/Output flags %%%%%%%%%%%%%%%%%%
Case              = Bessel1D                         # Case [ GEM | Dipole | ... ]
FieldsInit        = ./data/Initial-Fields_000000.h5  # Initial fields h5 file
PartInit          = maxwell                          # Initial particles [ maxwell | mono | File ]
PartInj           = mono                             # Particle injector [ maxwell | mono ]
WriteMethod       = ascii                            # Output method [ default | Parallel ]
PoissonCorrection = no                               # Poisson correction [ yes | no ]
SimulationName    = test                             # Simulation name for the output
Cylindrical = 1                                      # Cylindrical coordinates (true = 1, false = 0)
Lagrangian  = 0                                      # Lagrangian frame of reference
ZeroCurrent = 0                                      # 1 -> assure that the inital current is zero

MemPartGb   = -1                                     # Maximum memory allocated for the particles per process (Gb). If -1 it is not used


#  %%%%%%%%%%%%%%%%%%% Magnetic Reconnection %%%%%%%%%%%%%%%%%%
B0x = 0.0
B0y = 0.0
B0z = 0.0

B1x = 0.0
B1y = 0.0
B1z = 0.0

delta = 3.0

#  %%%%%%%%%%%%%%%%%%% TIME %%%%%%%%%%%%%%%%%%
dt = 0.125        # dt = time step this is still in wp-1
ncycles = 101     # cycles -- should run to 100us range for steady state
th = 0.5          # th =   decentering parameter
c = 1.0           # c = light speed 

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%
Smooth = 1.0      # Smoothing value (5-points stencil)
Nvolte = 6        # Cyles of smoothing and this must be even

#  %%%%%%%%%%%%%%%%%%% SMOOTH %%%%%%%%%%%%%%%%%%

# %%%%%%%%%%%%%%%%%% BOX SIZE %%%%%%%%%%%%%%%
Lx =   6.0        # Lx = simulation box length - x direction in m  
Ly =   6.0        # Ly = simulation box length - y direction in m
Lz =   0.1        # Lz = simulation box length - z direction in m  

x_center =   37.5 # center of initial square - x direction in m  
y_center =   37.5 # center of initial square - y direction in m
z_center =   0.05 # center of initial square - z direction in m  
L_square =   14.4 # side of initial square 


CoilD = 25.2        # magnetic coil diameter -- Proposed WB8 simulation dimensions. 
CoilSpacing= 40.0   # spacing parameter for magnets 
CoilThickness = 6.0 # Thickness of the coils (diameter)

nxc =  32         # nxc = number of cells - x direction  
nyc =  32         # nyc = number of cells - y direction
nzc =  1          # nzc = number of cells - z direction     


# %%%%%%%%%%%%%%%%%% MPI TOPOLOGY %%%%%%%%%%%%%%%
XLEN = 1          # Number of subdomains in the X direction
YLEN = 1          # Number of subdomains in the X direction
ZLEN = 1          # Number of subdomains in the X direction
   

# %%%%%%%%%%%%%% PARTICLES %%%%%%%%%%%%%%%%%
#    ns = number of species
#    0 = electrons
#    1 = protons
#    2,3,4,5,... = ions
ns = 1

x_center_inj =   37.5  37.5 # center of the injector - x direction in m  
y_center_inj =   37.5  37.5 # center of the injector - y direction in m
z_center_inj =   0.05  0.05 # center of the injector - z direction in m  
L_square_inj =   14.4  14.4 # diameter of the injector

rhoINIT         =    0.2     0.2        # Initial density (make sure you are neutral)
rhoINJECT       =    0.0     0.0        # Injected density 

TrackParticleID =    0       0          # TrackParticleID[species] = 1=true, 0=false 

npcelx          =    0      4          # Particles per cell in X
npcely          =    4      4          # Particles per cell in Y
npcelz          =    1      1           # Particles per cell in Z
NpMaxNpRatio    =   20.0                # Maximum number of particles allocated


qom             =  -1.0     1.0         # qom = charge to mass ratio for different species 			
uth             =   0.01    4.9e-3      # uth = thermal velocity for different species - Direction X 
vth             =   0.01    4.9e-3      # vth = thermal velocity for different species - Direction Y 
wth             =   0.01    4.9e-3      # wth = thermal velocity for different species - Direction Z
  
u0              =   0.0     0.0         # u0 = drift velocity   - Direction X  
v0              =   0.0     0.0         # v0 = drift velocity   - Direction Y 
w0              =   0.0     0.0         # w0 = drift velocity   - Direction Z    

# %%%%%%%%%%%% Periodicity in each direction %%%%%%%%%%%%%%%
PERIODICX       = 0                  # In direction X (1=true, 0=false)
PERIODICY       = 1                  # In direction Y (1=true, 0=false)
PERIODICZ       = 1                  # In direction Z (1=true, 0=false)

# %%%%%%%%%%%% boundary conditions %%%%%%%%%%%%%%%
# If the PERIODIC flag is active in the previous section
# periodic boundary conditions will be imposed
#
# PHI Electrostatic Potential     
# 0,1 = Dirichilet boundary condition ;     
# 2   = Neumann boundary condition
    bcPHIfaceXright = 1
    bcPHIfaceXleft  = 1
    bcPHIfaceYright = 1
    bcPHIfaceYleft  = 1
    bcPHIfaceZright = 1
    bcPHIfaceZleft  = 1
    
#    EM field boundary condition
#    0 = perfect conductor
#    1 = magnetic mirror
    bcEMfaceXright = 0
    bcEMfaceXleft =  0
    bcEMfaceYright = 0
    bcEMfaceYleft =  0
    bcEMfaceZright = 0
    bcEMfaceZleft =  0
    
#    Particles Boundary condition
#    0 = exit
#    1 = perfect mirror
#    2 = riemission
    bcPfaceXright = 0
    bcPfaceXleft =  0
    bcPfaceYright = 0
    bcPfaceYleft =  0
    bcPfaceZright = 0
    bcPfaceZleft =  0


# %%%%%%%%%%%% Numerics options %%%%%%%%%%%%%%%
verbose                = 1        # Print to video results
Vinj                   = 10       # Velocity of the injection from the wall
CGtol                  = 1E-3     # CG solver stopping criterium tolerance
GMREStol               = 1E-17    # GMRES solver stopping criterium tolerance
NiterMover             = 3        # mover predictor corrector iteration
FieldOutputCycle       = 10      # Output for field (if 0 it does not save fields data)
ParticlesOutputCycle   = 100000   # Output for particles (if 0 it does not save particles data)
RestartOutputCycle     = 200     # restart cycle
DiagnosticsOutputCycle = 1        # Diagnostics cycle



